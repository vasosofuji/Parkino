# Public mobile/browser configuration; use your PC LAN IP for a physical phone.
EXPO_PUBLIC_API_URL=http://localhost:3001
# Server only. Bind to 0.0.0.0 for trusted local-network phone testing.
HOST=127.0.0.1
PORT=3001
# Supabase PostgreSQL session-pooler connection, server only. See docs/SUPABASE.md.
# Leave unset for the shared local SQLite API during development.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# DATABASE_CA_FILE=./supabase-ca.crt
# Vercel: use the Supabase transaction pooler on port 6543 and enable this.
# DATABASE_POOL_MODE=transaction
ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Generate strong secrets; never prefix these with EXPO_PUBLIC_.
# ADMIN_API_KEY=
# OPERATOR_FEED_KEYS={"gradski":"secret","poc":"different-secret"}
# Optional server-only address-search endpoint (Nominatim-compatible).
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Server-only sign readers. Never use EXPO_PUBLIC_ for these keys.
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash
# SIGN_AI_TIMEOUT_MS=45000
# Demo: immediately accept human contributions and use the latest report.
DEMO_TRUST_INPUTS=true
