{
  "cli": { "version": ">= 16.0.0" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "environment": "preview",
      "env": { "EXPO_PUBLIC_OFFLINE_PREVIEW": "0" },
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": { "environment": "production", "env": { "EXPO_PUBLIC_OFFLINE_PREVIEW": "0" }, "autoIncrement": true }
  },
  "submit": { "production": {} }
}
