{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run typecheck && npm test && npm run export:web",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 180,
      "includeFiles": "{data/catalog.json,data/partners/**,certs/supabase-ca.crt}"
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api/index" },
    { "source": "/v1/:path*", "destination": "/api/index" },
    { "source": "/internal/:path*", "destination": "/api/index" },
    { "source": "/((?!api/|_expo/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/internal/sign-jobs", "schedule": "0 3 * * *" }]
}
